# Copia este archivo a .env y reemplaza TU_TOKEN_AQUI con tu propio token generado.
# Cómo generar el token:
#   Linux/macOS/Termux: openssl rand -hex 32
#   Python:             python3 -c "import secrets; print(secrets.token_hex(32))"
#   Windows PowerShell: -join ((48..57) + (97..102) | Get-Random -Count 64 | % {[char]$_})

DARKLY_TOKEN=TU_TOKEN_AQUI
ENABLE_SCAN=0
RATE_LIMIT_ENABLED=1
TRUST_PROXY=0
